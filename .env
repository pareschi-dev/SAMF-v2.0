# Provider usado pela aplicação: sqlite (padrão) ou postgres
DB_PROVIDER=sqlite

# PostgreSQL local. Não versionar o arquivo .env real.
DATABASE_URL=postgresql://postgres:The%401965@localhost:5432/samf

# Opcional: conexão administrativa usada apenas para criar o banco samf.
POSTGRES_ADMIN_URL=postgresql://postgres:The%401965@localhost:5432/postgres
